# 16-Bar Bossa Nova Jazz Standard (Minor i7-iv7 with bII Major modulation in Bars 9-12)

name = Blue Bossa 4/4
genre = BOSSA 4/4
examples = Blue Bossa (Kenny Dorham), Black Orpheus
meter = 4/4
bpm = 136
swing = 50
default_key = C
